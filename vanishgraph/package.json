{
  "name": "vanishgraph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VanishGraph Privacy Removal OS - evidence-first, multi-tenant privacy removal service. See PROJECT_BRIEF.md and .agent/specs/SPEC-000-product-scope.md.",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "typecheck": "sh scripts/typecheck.sh",
    "lint": "sh scripts/lint.sh",
    "format-check": "sh scripts/format-check.sh",
    "build": "sh scripts/build.sh",
    "test:unit": "sh scripts/test-unit.sh",
    "test:collection-guard": "sh scripts/test-collection-guard.sh",
    "reality-gate": "sh scripts/reality-gate.sh",
    "dependency-audit": "sh scripts/dependency-audit.sh",
    "gate:foundation": "sh scripts/gate-foundation.sh",
    "verify": "sh scripts/verify.sh",
    "serve": "node src/infrastructure/main.ts",
    "test:contract": "node --test \"tests/contract/**/*.test.ts\"",
    "test:integration": "sh scripts/test-integration.sh",
    "scan:truth-state": "node scripts/scan-truth-state-input.ts",
    "gate:api": "sh scripts/gate-api.sh",
    "gate:data": "sh scripts/gate-data.sh"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@fastify/type-provider-json-schema-to-ts": "5.0.0",
    "fastify": "5.12.4",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "pino": "10.3.1"
  }
}
