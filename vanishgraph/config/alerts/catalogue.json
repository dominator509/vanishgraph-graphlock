{
  "$comment": "The alert catalogue (SPEC-007 §8, §12.6; EP-008 M6(a)). Exactly 20 alert rows, each with its exact PromQL expression, threshold, `for` duration, severity, routing lane and runbook path, transcribed from §8's table. A placeholder in any field is a defect. Every metric named in an expression must be registered in config/metrics/catalogue.json (VG-OBS-016), and `sh scripts/metrics-catalogue-guard.sh` refuses an expression that refers to an unregistered metric. ROUTING LANES MEAN WHAT §8 SAYS: page (on-call paging, 5-minute acknowledgement objective), page-security (security on-call), ticket (operations queue, 1-business-day review), advisory (business hours, 4-hour working response objective).",
  "spec": "SPEC-007 §8 (alerting), §12.6; routing lanes and the required critical set are §8's own",
  "required_critical_set": ["A-01", "A-02", "A-03", "A-04", "A-05", "A-06", "A-07", "A-08", "A-09", "A-10"],
  "routing_lanes": {
    "page": "on-call paging with a 5-minute acknowledgement objective",
    "page-security": "security on-call",
    "ticket": "operations queue with a 1-business-day review",
    "advisory": "business-hours channel with a 4-hour working response objective"
  },
  "runbook_note": "RUNBOOKS ARE PATHS IN THIS CATALOGUE AND FILES IN THE REPOSITORY, AND THE TWO MUST AGREE: a catalogue row pointing at a document that does not exist is a promise nobody can keep, so `scripts/alert-catalogue-guard.sh` asserts that every path here exists and is non-empty. The 16 alert runbooks are EP-008 M6's work; §6 of the node plan names them and the incident-response runbook is the seventeenth document.",
  "alerts": [
    { "id": "A-01", "name": "Removal claim without verification", "expr": "sum by (source_class) (increase(vanishgraph_truth_state_transitions_total{truth_state=\"VERIFIED_REMOVED\"}[10m])) > sum by (source_class) (increase(vanishgraph_verification_observations_recorded_total[10m]))", "threshold": "any positive delta", "for": "0m", "severity": "critical", "routing": "page", "runbook": "docs/runbooks/alerts/removal-claim-without-verification.md" },
    { "id": "A-01b", "name": "VERIFIED_REMOVED record lacking an observation reference", "expr": "sum(increase(vanishgraph_truth_state_transitions_total{truth_state=\"VERIFIED_REMOVED\",has_verification_reference=\"false\"}[5m]))", "threshold": "> 0", "for": "0m", "severity": "critical", "routing": "page", "runbook": "docs/runbooks/alerts/removal-claim-without-verification.md" },
    { "id": "A-02", "name": "Verification-lag breach", "expr": "histogram_quantile(0.95, sum by (le) (rate(vanishgraph_verification_lag_seconds_bucket[6h]))) > 1209600", "threshold": "14 d p95", "for": "1h", "severity": "warning", "routing": "ticket", "runbook": "docs/runbooks/alerts/verification-lag-breach.md" },
    { "id": "A-03", "name": "Reappearance spike", "expr": "sum by (source_class) (rate(vanishgraph_reappearance_events_total{reappearance_window=\"LE_30D\"}[1h])) > 3 * (sum by (source_class) (rate(vanishgraph_reappearance_events_total{reappearance_window=\"LE_30D\"}[7d] offset 1d)) > 0 or vector(0.001))", "threshold": "3x 7-day baseline", "for": "30m", "severity": "warning", "routing": "ticket", "runbook": "docs/runbooks/alerts/reappearance-spike.md" },
    { "id": "A-04", "name": "Stale-recipe execution attempt", "expr": "sum by (source_class, reason_code) (increase(vanishgraph_stale_recipe_refusals_total[5m]))", "threshold": "> 0", "for": "0m", "severity": "critical", "routing": "page", "runbook": "docs/runbooks/alerts/stale-recipe-execution-attempt.md" },
    { "id": "A-05", "name": "Cross-tenant access attempt", "expr": "sum by (layer) (increase(vanishgraph_tenant_scope_refusals_total[5m]))", "threshold": "> 0", "for": "0m", "severity": "critical", "routing": "page-security", "runbook": "docs/runbooks/alerts/cross-tenant-access-attempt.md" },
    { "id": "A-06", "name": "DLP egress denial", "expr": "sum by (sink) (increase(vanishgraph_dlp_egress_denied_total[10m]))", "threshold": "> 5", "for": "10m", "severity": "warning", "routing": "ticket", "runbook": "docs/runbooks/alerts/dlp-egress-denial.md" },
    { "id": "A-06b", "name": "DLP denial of a prohibited class", "expr": "sum by (egress_class) (increase(vanishgraph_dlp_egress_denied_total{egress_class=~\"IDENTITY_DOCUMENT|AUTH_SECRET\"}[5m]))", "threshold": "> 0", "for": "0m", "severity": "critical", "routing": "page-security", "runbook": "docs/runbooks/alerts/dlp-egress-denial.md" },
    { "id": "A-06c", "name": "Canary reached a sink", "expr": "sum by (sink) (increase(vanishgraph_dlp_canary_detections_total[5m]))", "threshold": "> 0", "for": "0m", "severity": "critical", "routing": "page-security", "runbook": "docs/runbooks/alerts/dlp-canary-detection.md" },
    { "id": "A-07", "name": "Budget exhaustion", "expr": "max by (tenant_class, budget_key) (vanishgraph_action_budget_consumption_ratio) > 0.8", "threshold": "80 % of allowed effects", "for": "15m", "severity": "warning", "routing": "ticket", "runbook": "docs/runbooks/alerts/budget-exhaustion.md" },
    { "id": "A-07b", "name": "Budget exhausted", "expr": "sum by (budget_key) (increase(vanishgraph_action_budget_refusals_total{reason_code=\"BUDGET_EXHAUSTED\"}[15m]))", "threshold": "> 0", "for": "0m", "severity": "critical", "routing": "page", "runbook": "docs/runbooks/alerts/budget-exhaustion.md" },
    { "id": "A-08", "name": "Duplicate external effect detected", "expr": "sum by (channel, detection_path) (increase(vanishgraph_duplicate_external_effect_events_total[30m]))", "threshold": "> 0", "for": "0m", "severity": "critical", "routing": "page", "runbook": "docs/runbooks/alerts/duplicate-external-effect.md" },
    { "id": "A-09", "name": "Provider auth failure", "expr": "sum by (provider) (increase(vanishgraph_provider_auth_failures_total[10m]))", "threshold": "> 2", "for": "10m", "severity": "warning", "routing": "ticket", "runbook": "docs/runbooks/alerts/provider-auth-failure.md" },
    { "id": "A-09b", "name": "Provider auth failure sustained", "expr": "sum by (provider) (increase(vanishgraph_provider_auth_failures_total[30m]))", "threshold": "> 5", "for": "0m", "severity": "critical", "routing": "page", "runbook": "docs/runbooks/alerts/provider-auth-failure.md" },
    { "id": "A-10", "name": "Readiness flapping", "expr": "sum by (service) (increase(vanishgraph_readiness_state_changes_total[15m]))", "threshold": "> 6 in 15 m", "for": "5m", "severity": "warning", "routing": "advisory", "runbook": "docs/runbooks/alerts/readiness-flapping.md" },
    { "id": "A-11", "name": "Telemetry identity missing", "expr": "sum by (sink, reason_code) (increase(vanishgraph_telemetry_egress_failures_total{reason_code=\"RESOURCE_ATTR_MISSING\"}[10m]))", "threshold": "> 0", "for": "5m", "severity": "warning", "routing": "ticket", "runbook": "docs/runbooks/alerts/telemetry-identity-missing.md" },
    { "id": "A-12", "name": "Unresolved reconciliation", "expr": "sum by (channel) (increase(vanishgraph_reconciliation_events_total{outcome=\"UNRESOLVED\"}[1h]))", "threshold": "> 0", "for": "15m", "severity": "warning", "routing": "ticket", "runbook": "docs/runbooks/alerts/reconciliation-unresolved.md" },
    { "id": "A-13", "name": "Independence violation observed", "expr": "sum by (source_class) (increase(vanishgraph_verification_observations_recorded_total{path_distinct=\"false\"}[15m]))", "threshold": "> 0", "for": "0m", "severity": "critical", "routing": "page", "runbook": "docs/runbooks/alerts/verification-independence-violation.md" },
    { "id": "A-14", "name": "SLO error-budget burn", "expr": "vanishgraph_slo_error_budget_burn_ratio{objective=\"availability\"} > 2", "threshold": "2x budget rate", "for": "30m", "severity": "warning", "routing": "ticket", "runbook": "docs/runbooks/alerts/slo-budget-burn.md" },
    { "id": "A-15", "name": "Alert pipeline cannot evaluate", "expr": "absent(vanishgraph_truth_state_transitions_total{truth_state=\"VERIFIED_REMOVED\"}) or absent(vanishgraph_readiness_status)", "threshold": "absent series", "for": "10m", "severity": "critical", "routing": "page", "runbook": "docs/runbooks/alerts/alert-pipeline-blind.md" }
  ],
  "honesty_rules": [
    "No alert may fire on a threshold that can only be met when things are going well, and no alert may be phrased, labelled or annotated as a success notification (§8 coverage rule 2).",
    "No alert may be suppressed because its subject state is inconvenient; a removal claim without verification means an unverified claim is in the data, not that removal is happening.",
    "'Requests sent', 'submissions', 'actions taken' and permanent-deletion counts are never alert subjects: a metric asserting permanent deletion does not exist (SPEC-007 §6.3)."
  ]
}
