# Dependencies
node_modules/

# Build output (the artifact digest under .agent/evidence/ IS committed)
dist/
build/
.next/
coverage/

# Local environment and secrets. Never commit credentials (VG-SEC-002).
.env
.env.*
!.env.example
*.pem
*.key

# Logs and temp
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# NOTE: .agent/evidence/ is deliberately NOT ignored.
#
# It was ignored previously, which contradicted DOD-025 ("evidence ... preserved")
# and VG-EVIDENCE-002 (every claim resolves to a stored artifact hash).
# scripts/validate-generated-pack.py also reads
# .agent/evidence/<NODE>/anti_gaming_review.json, so ignoring that path made the
# pack validator unable to see evidence on a fresh clone.
#
# Evidence artifacts are hashes, command logs, and review records. They must not
# contain PII (VG-EGRESS-002); that is enforced at write time, not by gitignore.

# Restore-drill scratch dumps: run artefacts, not evidence. The DIGEST is committed
# (.agent/evidence/EP-003/restore-drill/dump-digest.txt) because the dump's bytes are specific
# to one container and one run, so they cannot be a durable identity (DOD-029).
.agent/evidence/**/restore-drill/*.dump

# UI build output: an ARTEFACT, not source. It is produced by `npm run build:web` and verified by
# `sh scripts/test-e2e.sh`, which REQUIRES it to exist — so committing it would let a stale bundle be
# the thing the end-to-end stage tests (SPEC-008 VG-SHIP-021/022 wants the freshly built artefact).
ui/dist/

# EP-005: the render harness mirror (tests/contract/render-support.ts). An ARTEFACT of a test run, never committed.
# It holds transpiled copies of ui/src, and Node refuses to load .ts under node_modules, which is why it is here.
.cache-ui-render/
# Build outputs are artifacts, not source: they are produced by scripts/build-artifact.sh and are never committed.
dist/
dist-*/

# Artifact extraction scratch (EP-009 M4): the smoke test unpacks the artifact here and removes it again.
.agent/verification/state/artifact-smoke/
.agent/verification/state/smoke-debug/
